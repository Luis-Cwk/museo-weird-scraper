# Bluesky (AT Protocol) — required for scraping
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social

# Search terms (comma-separated) for content discovery on Bluesky
BLUESKY_SEARCH_TERMS=museo robo,museo censura,arte maldito,artefacto robado,traficante arte,museo abandonado,momia guanajuato,ritual azteca,mercado negro arte,patrimonio saqueado

BLUESKY_SEARCH_LIMIT=20
BLUESKY_SEARCH_DELAY_MS=600

# Groq API (primary LLM — fast, free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# NVIDIA AI Endpoints (NIM) — fallback LLM
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional SVG output override
SVG_OUTPUT_DIR=

# Queue integrity (optional — defaults to a hardcoded value)
QUEUE_HMAC_SECRET=

# Pinata (IPFS uploads — optional for now)
PINATA_API_KEY=
PINATA_SECRET_KEY=

# Base Network (for future minting)
PRIVATE_KEY=
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Bluesky (AT Protocol) — required for scraping
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social

# Search terms (comma-separated) for content discovery on Bluesky
BLUESKY_SEARCH_TERMS=museo robo,museo censura,arte maldito,artefacto robado,traficante arte,museo abandonado,momia guanajuato,ritual azteca,mercado negro arte,patrimonio saqueado

BLUESKY_SEARCH_LIMIT=20
BLUESKY_SEARCH_DELAY_MS=600

# Groq API (primary LLM — fast, free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# NVIDIA AI Endpoints (NIM) — fallback LLM
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional SVG output override
SVG_OUTPUT_DIR=

# Queue integrity (optional — defaults to a hardcoded value)
QUEUE_HMAC_SECRET=

# Pinata (IPFS uploads — optional for now)
PINATA_API_KEY=
PINATA_SECRET_KEY=

# Base Network (for future minting)
PRIVATE_KEY=
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ============================================================================
# 2026-09-02: Mainnet + monitoring config
# ============================================================================

# --- Sepolia (current testnet) ---
SEPOLIA_RPC=https://ethereum-sepolia.publicnode.com
PRIVATE_KEY=                  # Sepolia deployer key (existing var above)

# --- Mainnet (production target) ---
MAINNET_RPC=https://ethereum-rpc.publicnode.com
MAINNET_PRIVATE_KEY=           # Mainnet deployer key — MUST be DIFFERENT from Sepolia
                                # Get this from your hardware wallet or new dedicated wallet
                                # Fund with ~0.5 ETH for deploy + first 50 mints
MAINNET_CONFIRM=               # Safety gate: must be "YES" (uppercase) to run mainnet deploy
                                # If unset, deploy.js aborts before sending any transaction

# --- Auction duration (random range in hours) ---
# Random auction duration in [min, max] hours. Default 6-12h.
AUCTION_DURATION_MIN_HOURS=6
AUCTION_DURATION_MAX_HOURS=12

# --- Lazy scrape (cycles between full scrapes) ---
# Scraping runs every N cycles instead of every cycle (saves API quota).
# Default: 5. Set to 999 to effectively disable scraping.
SCRAPE_INTERVAL_CYCLES=5

# --- Huaca monitoring (optional but recommended) ---
# Telegram credentials for huaca-monitor.py alerts.
# Without these, monitor runs in silent mode (no Telegram pushes).
TELEGRAM_BOT_TOKEN=            # Get from @BotFather
TELEGRAM_CHAT_ID=              # Your personal chat ID or a group ID for alerts

# --- Etherscan verification (optional) ---
ETHERSCAN_API_KEY=              # Get from etherscan.io → API Keys
                                # Used to verify contract source on Etherscan after deploy
